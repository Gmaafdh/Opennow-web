+                  if (item.disabled || !item.page) return;
+                  onNavigate(item.page);
+                }}
+                aria-label={item.label}
+                aria-current={isActive ? "page" : undefined}
+                title={item.label}
+                disabled={item.disabled}
+              >
+                <Icon size={20} />
+                <span className="side-rail-item-glow" aria-hidden="true" />
+              </button>
+            );
